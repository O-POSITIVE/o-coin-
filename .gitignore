__pycache__/
*.pyc

# Local secrets (DATABASE_URL, OCOIN_NODE_SHARED_SECRET) for running
# node.py locally — never commit this, matches trading-platform's own .env
# convention.
.env

# Per-node chain persistence and logs — regenerated by running node.py,
# never something to commit (also port-specific by design, see node.py).
chain_data_*.db
*.log

# Throwaway wallet/miner identities generated during local testing.
miner_wallet.txt
miner_addr.txt

# Personal double-click launchers — convenient to hardcode
# OCOIN_NODE_SHARED_SECRET into these for one-click use (unlike node.py/
# miner.py, which are real source and read it from the environment
# instead), so keep them out of git entirely rather than relying on
# remembering not to `git add -A` over a file containing a real secret.
Start Mining.bat
Check My Wallet.bat
check_wallet.py

# Personal key/wallet notes — never commit private key material.
*KEY*.txt
*WALLET*INFO*.txt
